# =====================================================================
# 25. ŞİMDİ ASIL TABLE 1
# =====================================================================
#
# gtsummary bazen az sayıda farklı değer içeren numeric
# değişkenleri otomatik olarak kategorik kabul eder.
#
# Örneğin parite = 1,2,3,4,5... olduğunda bunu ayrı kategoriler
# olarak gösterebilir. BİZ BUNU İSTEMİYORUZ, bu nedenle
# type = list(...) içerisinde AÇIKÇA "continuous" diyoruz.
# =====================================================================


table1 <- demografi %>%
    
    select(
        
        rezidu_grup,
        
        yas,
        
        bmi,
        
        gravida,
        
        parite,
        
        abortus,
        
        nsd,
        
        cs,
        
        menopoz_grup,
        
        sigara_grup
        
    ) %>%
    
    tbl_summary(
        
        by = rezidu_grup,
        
        type = list(
            
            yas ~ "continuous",
            
            bmi ~ "continuous",
            
            gravida ~ "continuous",
            
            parite ~ "continuous",
            
            abortus ~ "continuous",
            
            nsd ~ "continuous",
            
            cs ~ "continuous",
            
            menopoz_grup ~ "categorical",
            
            sigara_grup ~ "categorical"
            
        ),
        
        missing = "no",
        
        statistic = list(
            
            c(
                yas,
                bmi
            ) ~ "{mean} ± {sd}",
            
            c(
                gravida,
                parite,
                abortus,
                nsd,
                cs
            ) ~ "{median} ({p25}–{p75})",
            
            all_categorical() ~ "{n} ({p}%)"
            
        ),
        
        digits = list(
            
            c(
                yas,
                bmi
            ) ~ 1,
            
            c(
                gravida,
                parite,
                abortus,
                nsd,
                cs
            ) ~ 1,
            
            all_categorical() ~ c(0, 1)
            
        ),
        
        label = list(
            
            yas ~ "Yaş, yıl",
            
            bmi ~ "BMI, kg/m²",
            
            gravida ~ "Gravida",
            
            parite ~ "Parite",
            
            abortus ~ "Abortus",
            
            nsd ~ "NSD sayısı",
            
            cs ~ "C/S sayısı",
            
            menopoz_grup ~ "Menopoz durumu",
            
            sigara_grup ~ "Sigara kullanımı"
            
        )
        
    )



# =====================================================================
