table1 <- table1 %>%
    
    add_p(
        
        test = list(
            
            c(
                yas,
                bmi
            ) ~ "t.test",
            
            c(
                gravida,
                parite,
                abortus,
                nsd,
                cs
            ) ~ "wilcox.test",
            
            c(
                menopoz_grup,
                sigara_grup
            ) ~ "fisher.test"
            
        ),
        
        pvalue_fun = function(x) {
            
            style_pvalue(
                x,
                digits = 3
            )
            
        }
        
    )



# =====================================================================
# 27. DEĞİŞKEN İSİMLERİNİ KALIN YAP
# =====================================================================

table1 <- table1 %>%
    
    bold_labels()



