# ======================================================================
# 8. GÜVENLİ TARİH FONKSİYONU
# ======================================================================
#
# charToDate hatası vermeyecek şekilde hazırlanmıştır.
#
# ======================================================================

guvenli_tarih <- function(x) {
  
  # Zaten Date ise
  if (inherits(x, "Date")) {
    return(x)
  }
  
  # POSIX ise
  if (inherits(x, "POSIXt")) {
    return(as.Date(x))
  }
  
  # Numeric Excel seri numarası ise
  if (is.numeric(x)) {
    
    sonuc <- rep(as.Date(NA), length(x))
    
    uygun <- !is.na(x)
    
    sonuc[uygun] <- as.Date(
      x[uygun],
      origin = "1899-12-30"
    )
    
    return(sonuc)
  }
  
  # Character
  x_chr <- trimws(as.character(x))
  
  x_chr[
    x_chr %in% c(
      "",
      "NA",
      "N/A",
      "-",
      "."
    )
  ] <- NA_character_
  
  sonuc <- rep(as.Date(NA), length(x_chr))
  
  
  # --------------------------------------------------------------
  # Character biçiminde Excel seri numarası olabilir
  # --------------------------------------------------------------
  
  x_num <- suppressWarnings(as.numeric(x_chr))
  
  seri <- !is.na(x_num) &
    x_num > 1000 &
    x_num < 100000
  
  if (any(seri)) {
    
    sonuc[seri] <- as.Date(
      x_num[seri],
      origin = "1899-12-30"
    )
    
  }
  
  
  # --------------------------------------------------------------
  # Tarih formatlarını sırayla dene
  # --------------------------------------------------------------
  
  formatlar <- c(
    "%Y-%m-%d",
    "%Y/%m/%d",
    "%Y.%m.%d",
    "%d.%m.%Y",
    "%d/%m/%Y",
    "%d-%m-%Y",
    "%d.%m.%y",
    "%d/%m/%y",
    "%d-%m-%y"
  )
  
  for (fmt in formatlar) {
    
    idx <- is.na(sonuc) & !is.na(x_chr)
    
    if (!any(idx)) break
    
    gecici <- suppressWarnings(
      as.Date(
        x_chr[idx],
        format = fmt
      )
    )
    
    sonuc[idx] <- gecici
  }
  
  
  # --------------------------------------------------------------
  # Saat içeren kayıt varsa ilk 10 karakteri dene
  # --------------------------------------------------------------
  
  for (fmt in c(
    "%Y-%m-%d",
    "%d.%m.%Y",
    "%d/%m/%Y",
    "%d-%m-%Y"
  )) {
    
    idx <- is.na(sonuc) & !is.na(x_chr)
    
    if (!any(idx)) break
    
    kisa <- substr(
      x_chr[idx],
      1,
      10
    )
    
    gecici <- suppressWarnings(
      as.Date(
        kisa,
        format = fmt
      )
    )
    
    sonuc[idx] <- gecici
  }
  
  return(sonuc)
}


