# ======================================================================

veri <- veri %>%
  mutate(
    
    rezidu_grup = case_when(
      rezidu == 0 ~ "Rezidü negatif",
      rezidu == 1 ~ "Rezidü pozitif",
      TRUE ~ NA_character_
    )
    
  )

veri$rezidu_grup <- factor(
  veri$rezidu_grup,
  levels = c(
    "Rezidü negatif",
    "Rezidü pozitif"
  )
)


# ======================================================================
# 14. TAKVİM AYI OLARAK SÜRE
# ======================================================================
#
# Örnek:
#
# 01.01.2024 -> 01.04.2024 = 3 ay
#
# ======================================================================

veri <- veri %>%
  mutate(
    
    ilk_yil = as.integer(
      format(
        ilk_leep_tarihi,
        "%Y"
      )
    ),
    
    ilk_ay = as.integer(
      format(
        ilk_leep_tarihi,
        "%m"
      )
    ),
    
    re_yil = as.integer(
      format(
        reeksizyon_tarihi,
        "%Y"
      )
    ),
    
    re_ay = as.integer(
      format(
        reeksizyon_tarihi,
        "%m"
      )
    ),
    
    sure_ay =
      (re_yil - ilk_yil) * 12 +
      (re_ay - ilk_ay)
    
  )


# ======================================================================
# 15. NEGATİF SÜRE KONTROLÜ
# ======================================================================

negatif_sure <- veri %>%
  filter(
    !is.na(sure_ay),
