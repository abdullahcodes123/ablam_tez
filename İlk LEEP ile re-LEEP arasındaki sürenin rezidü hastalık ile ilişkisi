# ======================================================================

if (
  n_negatif == 0 ||
  n_pozitif == 0
) {
  
  stop(
    "Rezidü negatif ve pozitif grupların ikisi de mevcut değil."
  )
  
}


# ======================================================================
# 19. TANIMLAYICI İSTATİSTİKLER
# ======================================================================

ozet <- analiz %>%
  group_by(
    rezidu_grup
  ) %>%
  summarise(
    
    N = n(),
    
    Ortalama =
      mean(sure_ay),
    
    SD =
      sd(sure_ay),
    
    Medyan =
      median(sure_ay),
    
    Q1 =
      as.numeric(
        quantile(
          sure_ay,
          0.25
        )
      ),
    
    Q3 =
      as.numeric(
        quantile(
          sure_ay,
          0.75
        )
      ),
    
    Minimum =
      min(sure_ay),
    
    Maksimum =
      max(sure_ay),
    
    .groups = "drop"
    
  )


cat("\n============================================================\n")
cat("TANIMLAYICI İSTATİSTİKLER\n")
cat("============================================================\n")

print(
  as.data.frame(ozet)
)


# ======================================================================
# 20. MANN-WHITNEY U TESTİ
# ======================================================================

mw <- wilcox.test(
  sure_ay ~ rezidu_grup,
  data = analiz,
  exact = FALSE
)

p_mw <- mw$p.value


cat("\n============================================================\n")
cat("MANN-WHITNEY U TESTİ\n")
cat("============================================================\n")

print(mw)


# ======================================================================
# 21. LOJİSTİK REGRESYON
# ======================================================================
#
# rezidu = 0 / 1
#
# Model:
#
# rezidu ~ sure_ay
#
# ======================================================================

model <- glm(
  rezidu ~ sure_ay,
  data = analiz,
  family = binomial(link = "logit")
)


cat("\n============================================================\n")
cat("LOJİSTİK REGRESYON\n")
cat("============================================================\n")

print(
  summary(model)
)


# ======================================================================
# 22. OR, %95 GA VE p
# ======================================================================

beta <- coef(model)[["sure_ay"]]

se <- sqrt(
  vcov(model)[
    "sure_ay",
    "sure_ay"
  ]
)

p_logistik <- summary(model)$coefficients[
  "sure_ay",
  "Pr(>|z|)"
]


OR_1ay <- exp(beta)

Alt95_1ay <- exp(
  beta - 1.96 * se
)

Ust95_1ay <- exp(
  beta + 1.96 * se
)


# ======================================================================
# 23. 3 AYLIK ARTIŞ İÇİN OR
# ======================================================================

OR_3ay <- exp(
  beta * 3
)

Alt95_3ay <- exp(
  (beta - 1.96 * se) * 3
)

Ust95_3ay <- exp(
  (beta + 1.96 * se) * 3
)


# ======================================================================
# 24. GRUP ÖZETLERİNİ AL
# ======================================================================

neg <- ozet %>%
  filter(
    rezidu_grup == "Rezidü negatif"
  )

poz <- ozet %>%
  filter(
    rezidu_grup == "Rezidü pozitif"
  )


# ======================================================================
# 25. p DEĞERİ YAZDIRMA FONKSİYONU
# ======================================================================

p_yaz <- function(p) {
  
  if (is.na(p)) {
    
    return("NA")
    
  } else if (p < 0.001) {
    
    return("<0.001")
    
  } else {
    
    return(
      sprintf("%.3f", p)
    )
    
  }
  
}


