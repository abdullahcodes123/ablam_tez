# ======================================================================
# 7. SÜREKLİ DEĞİŞKENLER İÇİN POWER FONKSİYONU
# ======================================================================

power_surekli <- function(
    n_negatif,
    n_pozitif,
    d,
    alfa
) {
  
  sonuc <- pwr::pwr.t2n.test(
    
    n1 = n_pozitif,
    
    n2 = n_negatif,
    
    d = d,
    
    sig.level = alfa,
    
    alternative = "two.sided"
    
  )
  
  return(
    sonuc$power
  )
}


# ======================================================================
# 8. SÜREKLİ DEĞİŞKENLER İÇİN GEREKLİ NEGATİF N
# ======================================================================

gerekli_negatif_surekli <- function(
    d,
    n_pozitif = 140,
    hedef_power = 0.80,
    alfa = 0.05,
    max_n = 100000
) {
  
  
  # --------------------------------------------------------------
  # Önce teorik maksimum gücü yaklaşık olarak kontrol ediyoruz.
  #
  # Negatif grup çok büyüdüğünde pwr.t2n.test ile max_n kullanılır.
  # --------------------------------------------------------------
  
  maksimum_power <- power_surekli(
    
    n_negatif = max_n,
    
    n_pozitif = n_pozitif,
    
    d = d,
    
    alfa = alfa
    
  )
  
  
  # --------------------------------------------------------------
  # 140 pozitif ile hedef güce ulaşılamıyorsa
  # --------------------------------------------------------------
  
  if (maksimum_power < hedef_power) {
    
    return(
      
      data.frame(
        
        etki = d,
        
        gerekli_negatif_n = NA_integer_,
        
        toplam_n = NA_integer_,
        
        elde_edilen_power = maksimum_power,
        
        durum =
          "140 pozitif ile %80 güce ulaşılamaz"
        
      )
      
    )
    
  }
  
  
  # --------------------------------------------------------------
  # Önce kaba arama
  # --------------------------------------------------------------
  
  alt <- 2L
  
  ust <- 2L
  
  
  while (
    
    power_surekli(
      ust,
      n_pozitif,
      d,
      alfa
    ) < hedef_power &&
    
    ust < max_n
    
  ) {
    
    ust <- min(
      ust * 2L,
      max_n
    )
    
  }
  
  
  # --------------------------------------------------------------
  # Binary search:
  # hedefe ulaşan EN KÜÇÜK negatif N
  # --------------------------------------------------------------
  
  while (alt < ust) {
    
    orta <- floor(
      (alt + ust) / 2
    )
    
    
    pw <- power_surekli(
      
      n_negatif = orta,
      
      n_pozitif = n_pozitif,
      
      d = d,
      
      alfa = alfa
      
    )
    
    
    if (pw >= hedef_power) {
      
      ust <- orta
      
    } else {
      
      alt <- orta + 1L
      
    }
    
  }
  
  
  gerekli_n <- alt
  
  
  final_power <- power_surekli(
    
    n_negatif = gerekli_n,
    
    n_pozitif = n_pozitif,
    
    d = d,
    
    alfa = alfa
    
  )
  
  
  data.frame(
    
    etki = d,
    
    gerekli_negatif_n = gerekli_n,
    
    toplam_n =
      n_pozitif + gerekli_n,
    
    elde_edilen_power =
      final_power,
    
    durum =
      "Hedef güce ulaşılıyor"
    
  )
  
}


