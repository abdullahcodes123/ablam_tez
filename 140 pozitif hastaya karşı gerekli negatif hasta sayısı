# ======================================================================
# 11. KATEGORİK DEĞİŞKEN İÇİN POWER FONKSİYONU
# ======================================================================

power_kategorik <- function(
    n_negatif,
    n_pozitif,
    h,
    alfa
) {
  
  sonuc <- pwr::pwr.2p2n.test(
    
    h = h,
    
    n1 = n_pozitif,
    
    n2 = n_negatif,
    
    sig.level = alfa,
    
    alternative = "two.sided"
    
  )
  
  
  return(
    sonuc$power
  )
}


# ======================================================================
# 12. KATEGORİK DEĞİŞKENLER İÇİN GEREKLİ NEGATİF N
# ======================================================================

gerekli_negatif_kategorik <- function(
    h,
    n_pozitif = 140,
    hedef_power = 0.80,
    alfa = 0.05,
    max_n = 100000
) {
  
  
  # --------------------------------------------------------------
  # Maksimum ulaşılabilir güç
  # --------------------------------------------------------------
  
  maksimum_power <- power_kategorik(
    
    n_negatif = max_n,
    
    n_pozitif = n_pozitif,
    
    h = h,
    
    alfa = alfa
    
  )
  
  
  # --------------------------------------------------------------
  # Hedef güce teorik olarak ulaşılamıyorsa
  # --------------------------------------------------------------
  
  if (maksimum_power < hedef_power) {
    
    return(
      
      data.frame(
        
        etki = h,
        
        gerekli_negatif_n = NA_integer_,
        
        toplam_n = NA_integer_,
        
        elde_edilen_power = maksimum_power,
        
        durum =
          "140 pozitif ile %80 güce ulaşılamaz"
        
      )
      
    )
    
  }
  
  
  # --------------------------------------------------------------
  # Kaba arama
  # --------------------------------------------------------------
  
  alt <- 2L
  
  ust <- 2L
  
  
  while (
    
    power_kategorik(
      ust,
      n_pozitif,
      h,
      alfa
    ) < hedef_power &&
    
    ust < max_n
    
  ) {
    
    ust <- min(
      ust * 2L,
      max_n
    )
    
  }
  
  
  # --------------------------------------------------------------
  # Binary search
  # --------------------------------------------------------------
  
  while (alt < ust) {
    
    orta <- floor(
      (alt + ust) / 2
    )
    
    
    pw <- power_kategorik(
      
      n_negatif = orta,
      
      n_pozitif = n_pozitif,
      
      h = h,
      
      alfa = alfa
      
    )
    
    
    if (pw >= hedef_power) {
      
      ust <- orta
      
    } else {
      
      alt <- orta + 1L
      
    }
    
  }
  
  
  gerekli_n <- alt
  
  
  final_power <- power_kategorik(
    
    n_negatif = gerekli_n,
    
    n_pozitif = n_pozitif,
    
    h = h,
    
    alfa = alfa
    
  )
  
  
  data.frame(
    
    etki = h,
    
    gerekli_negatif_n = gerekli_n,
    
    toplam_n =
      n_pozitif + gerekli_n,
    
    elde_edilen_power =
      final_power,
    
    durum =
      "Hedef güce ulaşılıyor"
    
  )
  
}


