# ======================================================================
# 15. TESTİ OTOMATİK SEÇ
# ======================================================================
#
# Pratik ve konservatif karar:
#
# Herhangi bir beklenen hücre < 5 ise:
#     Fisher exact test
#
# Tüm beklenen hücreler >= 5 ise:
#     Pearson Ki-kare testi
#
# 2x2 tabloda Yates continuity correction kullanmıyoruz;
# Pearson chi-square correct = FALSE olarak hesaplanıyor.
# ======================================================================

if (any(beklenen < 5)) {

  kullanilan_test <-
    "Fisher exact testi"

  ana_test <-
    fisher.test(
      capraz_tablo
    )

  p_degeri <-
    ana_test$p.value

} else {

  kullanilan_test <-
    "Pearson Ki-kare testi"

  ana_test <-
    chisq.test(
      capraz_tablo,
      correct = FALSE
    )

  p_degeri <-
    ana_test$p.value

}


