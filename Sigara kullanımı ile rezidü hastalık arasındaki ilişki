# Mann-Whitney U testi kullanıyoruz.
# ----------------------------------------------------------------------

if (
  nrow(paket_yil_analiz) > 0 &&
  length(unique(paket_yil_analiz$rezidu_binary)) == 2
) {

  paket_yil_mann <-
    wilcox.test(

      paket_yil ~ rezidu_grup,

      data =
        paket_yil_analiz,

      exact =
        FALSE

    )


  cat("\nPaket-yıl Mann-Whitney U testi:\n")

  print(
    paket_yil_mann
  )

} else {

  paket_yil_mann <- NULL

  cat(
    "\nPaket-yıl karşılaştırması için yeterli veri yok.\n"
  )

}


# ----------------------------------------------------------------------
# 26. PAKET-YIL UNİVARIABLE LOJİSTİK REGRESYON
# ----------------------------------------------------------------------
#
# Buradaki OR:
#
# paket-yıldaki HER 1 BİRİM artış için OR'dur.
#
# Daha klinik yorum için aşağıda ayrıca her 10 paket-yıl
# artış başına OR hesaplanmaktadır.
# ----------------------------------------------------------------------

if (
  nrow(paket_yil_analiz) > 0 &&
  length(unique(paket_yil_analiz$rezidu_binary)) == 2
) {

  paket_yil_analiz <-
    paket_yil_analiz %>%

    mutate(
      paket_yil_10 =
        paket_yil / 10
    )


  model_paket_yil <-
    glm(

      rezidu_binary ~ paket_yil_10,

      data =
        paket_yil_analiz,

      family =
        binomial(
          link = "logit"
        )

    )


  paket_yil_or <-
    broom::tidy(

      model_paket_yil,

      conf.int = TRUE,

      exponentiate = TRUE

    ) %>%

    filter(
      term == "paket_yil_10"
    ) %>%

    transmute(

      Degisken =
        "Paket-yıl (her 10 paket-yıl artış)",

      OR =
        estimate,

      Alt_95_GA =
        conf.low,

      Ust_95_GA =
        conf.high,

      p_degeri =
        p.value

    )


  cat("\n")
  cat("Paket-yıl lojistik regresyonu:\n")

  print(
    paket_yil_or
  )


} else {

  paket_yil_or <-
    data.frame(

      Degisken =
        character(),

      OR =
        numeric(),

      Alt_95_GA =
        numeric(),

      Ust_95_GA =
        numeric(),

      p_degeri =
        numeric()

    )

}


