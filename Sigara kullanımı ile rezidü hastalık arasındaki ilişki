# ----------------------------------------------------------------------

paket_yil_tanimlayici <-
  paket_yil_analiz %>%

  group_by(
    rezidu_grup
  ) %>%

  summarise(

    N =
      n(),

    Ortalama =
      mean(
        paket_yil,
        na.rm = TRUE
      ),

    SD =
      sd(
        paket_yil,
        na.rm = TRUE
      ),

    Medyan =
      median(
        paket_yil,
        na.rm = TRUE
      ),

    Q1 =
      quantile(
        paket_yil,
        0.25,
        na.rm = TRUE
      ),

    Q3 =
      quantile(
        paket_yil,
        0.75,
        na.rm = TRUE
      ),

    Minimum =
      min(
        paket_yil,
        na.rm = TRUE
      ),

    Maksimum =
      max(
        paket_yil,
        na.rm = TRUE
      ),

    .groups =
      "drop"

  )


print(
  paket_yil_tanimlayici
)


