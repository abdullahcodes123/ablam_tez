# ======================================================================
# 16. CRUDE ODDS RATIO
# ======================================================================
#
# OR aşağıdaki karşılaştırmayı ifade eder:
#
# Sigara kullanan vs kullanmayan
#
# Outcome:
# Rezidü pozitif vs negatif
#
# OR > 1:
# Sigara kullananlarda rezidü pozitifliği odds'u daha yüksek.
#
# OR < 1:
# Sigara kullananlarda rezidü pozitifliği odds'u daha düşük.
#
# OR = 1:
# Odds açısından ilişki yok.
#
# %95 GA 1'i içeriyorsa klasik alfa=0.05 düzeyinde
# istatistiksel olarak anlamlı ilişki desteklenmez.
# ======================================================================

model_sigara <- glm(

  rezidu_binary ~ sigara_binary,

  data = sigara_analiz,

  family = binomial(
    link = "logit"
  )

)


sigara_or <- broom::tidy(

  model_sigara,

  conf.int = TRUE,

  exponentiate = TRUE

) %>%

  filter(
    term == "sigara_binary"
  ) %>%

  transmute(

    Degisken =
      "Sigara kullanıyor (referans: kullanmıyor)",

    OR =
      estimate,

    Alt_95_GA =
      conf.low,

    Ust_95_GA =
      conf.high,

    p_degeri =
      p.value

  )


cat("\n")
cat("============================================================\n")
cat("UNIVARIABLE LOJİSTİK REGRESYON\n")
cat("============================================================\n")

