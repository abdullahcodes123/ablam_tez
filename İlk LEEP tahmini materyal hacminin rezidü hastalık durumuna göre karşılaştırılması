# ----------------------------------------------------------------------
# 13. SHAPIRO-WILK TESTİ
# ----------------------------------------------------------------------

shapiro_sonuc <- hacim_analiz %>%
  group_by(rezidu_grup) %>%
  group_modify(
    ~ data.frame(

      N = nrow(.x),

      W =
        unname(
          shapiro.test(
            .x$leep_hacim_cm3
          )$statistic
        ),

      p_degeri =
        shapiro.test(
          .x$leep_hacim_cm3
        )$p.value
    )
  ) %>%
  ungroup()


cat("\n")
