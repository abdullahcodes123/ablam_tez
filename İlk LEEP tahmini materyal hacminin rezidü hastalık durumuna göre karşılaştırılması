cat("SHAPIRO-WILK\n")
cat("============================================================\n")

print(shapiro_sonuc)


# ----------------------------------------------------------------------
# 14. ANA İSTATİSTİKSEL KARŞILAŞTIRMA
#     MANN-WHITNEY U TESTİ
# ----------------------------------------------------------------------
#
# Hacim dağılımının olası çarpıklığı, küçük örneklem ve aynı
# değerlerin bulunabilmesi nedeniyle ana karşılaştırma
# Mann-Whitney U testi ile yapılmaktadır.
#
# NOT: Formül katsayısı düzeltmesi (Bölüm 7) bu testin p
# değerini DEĞİŞTİRMEZ - Mann-Whitney sıralamalara (rank)
# dayanır ve sabit pozitif bir katsayıyla çarpmaya duyarsızdır.
#
# exact = FALSE ties nedeniyle oluşabilecek uyarıları engeller.
# ----------------------------------------------------------------------

mann_whitney <- wilcox.test(
  leep_hacim_cm3 ~ rezidu_grup,
  data = hacim_analiz,
  exact = FALSE
)


p_mann <- mann_whitney$p.value


cat("\n")
cat("============================================================\n")
cat("MANN-WHITNEY U TESTİ\n")
cat("============================================================\n")

print(mann_whitney)


# ----------------------------------------------------------------------
# 15. DESTEKLEYİCİ WELCH T-TESTİ
# ----------------------------------------------------------------------

welch_test <- t.test(
  leep_hacim_cm3 ~ rezidu_grup,
  data = hacim_analiz,
  var.equal = FALSE
)


cat("\n")
cat("============================================================\n")
cat("WELCH T-TESTİ - DESTEKLEYİCİ ANALİZ\n")
cat("============================================================\n")

print(welch_test)


# ======================================================================
# 16. YAYINA / TEZE UYGUN ANA TABLOYU OLUŞTUR
# ======================================================================
#
# Bu tablo:
#
# - Her grubun N sayısını
# - Ortalama ± SS
# - Medyan (Q1–Q3)
# - Mann-Whitney p değerini
#
# birlikte gösterecektir.
#
# Ana karşılaştırma medyan/rank temelli olduğu için p değeri
# Mann-Whitney U testinden alınmaktadır (Welch t-testi yalnızca
# destekleyici/karşılaştırma amaçlı konsolda raporlanmıştır,
# ana tabloya dahil edilmemiştir).
# ======================================================================


# Rezidü negatif grup

negatif <- hacim_analiz %>%
  filter(rezidu_binary == 0)


# Rezidü pozitif grup

pozitif <- hacim_analiz %>%
  filter(rezidu_binary == 1)


# Grup istatistiklerini metin formatında hazırla

negatif_ortalama <- sprintf(
  "%.2f ± %.2f",
  mean(negatif$leep_hacim_cm3),
  sd(negatif$leep_hacim_cm3)
)


pozitif_ortalama <- sprintf(
  "%.2f ± %.2f",
  mean(pozitif$leep_hacim_cm3),
  sd(pozitif$leep_hacim_cm3)
)


negatif_medyan <- sprintf(
  "%.2f (%.2f–%.2f)",
  median(negatif$leep_hacim_cm3),
  quantile(negatif$leep_hacim_cm3, 0.25),
  quantile(negatif$leep_hacim_cm3, 0.75)
)


pozitif_medyan <- sprintf(
  "%.2f (%.2f–%.2f)",
  median(pozitif$leep_hacim_cm3),
  quantile(pozitif$leep_hacim_cm3, 0.25),
  quantile(pozitif$leep_hacim_cm3, 0.75)
)


# P değerini bilimsel gösterime uygun biçimde yaz

p_yaz <- ifelse(
  p_mann < 0.001,
  "<0.001",
  sprintf("%.3f", p_mann)
)


# Ana tablo veri seti

tablo_hacim <- data.frame(

  Degisken = c(
    "Tahmini LEEP materyal hacmi, cm³",
    "  Ortalama ± SS",
    "  Medyan (Q1–Q3)"
  ),

  Rezidu_negatif = c(
    paste0("n = ", nrow(negatif)),
    negatif_ortalama,
    negatif_medyan
  ),

  Rezidu_pozitif = c(
    paste0("n = ", nrow(pozitif)),
    pozitif_ortalama,
    pozitif_medyan
  ),

  P_degeri = c(
    "",
    "",
    p_yaz
  ),

  stringsAsFactors = FALSE
)


