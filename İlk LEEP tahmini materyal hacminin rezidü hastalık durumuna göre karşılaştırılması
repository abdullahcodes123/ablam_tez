# ----------------------------------------------------------------------
# 7. PHADNIS FORMÜLÜNE GÖRE TAHMİNİ LEEP HACMİNİ HESAPLA (v2 - DÜZELTİLDİ)
# ----------------------------------------------------------------------
#
# Phadnis hemiellipsoid modeli:
#
# V = (1/2) × (4/3) × pi × (a/2) × (b/2) × c
#   = (pi / 6) × a × b × c
#
# a = 3–9 ekseni (transverse diameter - ÇAP, bu yüzden /2)
# b = 6–12 ekseni (longitudinal diameter - ÇAP, bu yüzden /2)
# c = Os kalınlığı / materyal derinliği (DERİNLİK - zaten bir
#     yükseklik/radius değeri, çap DEĞİL - bu yüzden BÖLÜNMEZ)
#
# Tüm ölçüler cm ise sonuç cm³ olur.
# ----------------------------------------------------------------------

veri <- veri %>%
  mutate(

    leep_hacim_cm3 =
      (pi / 6) *
      eksen_3_9 *
      eksen_6_12 *
      os_kalinligi

  )


