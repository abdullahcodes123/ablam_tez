# ----------------------------------------------------------------------
# 21. UNİVARIABLE LOJİSTİK REGRESYON
# ----------------------------------------------------------------------
#
# OR:
# Tahmini hacimde her 1 cm³ artış için rezidü hastalık odds
# değişimini gösterir.
#
# NOT: Bu OR artık DÜZELTİLMİŞ (doğru ölçekli) hacim üzerinden
# hesaplanıyor. Eski (yanlış, yarı ölçekli) formülle
# hesaplanan OR ile SAYISAL OLARAK FARKLI olacaktır - bu
# beklenen ve doğru bir değişikliktir.
# ----------------------------------------------------------------------

model_hacim <- glm(
  rezidu_binary ~ leep_hacim_cm3,
  data = hacim_analiz,
  family = binomial(link = "logit")
)


lojistik_sonuc <- broom::tidy(
  model_hacim,
  conf.int = TRUE,
  exponentiate = TRUE
) %>%

  filter(
    term == "leep_hacim_cm3"
  ) %>%

  transmute(

    Degisken =
      "Tahmini LEEP hacmi (her 1 cm³ artış)",

    OR =
      estimate,

    Alt_95_GA =
      conf.low,

    Ust_95_GA =
      conf.high,

    p_degeri =
      p.value
  )


cat("\n")
cat("============================================================\n")
cat("LOJİSTİK REGRESYON (düzeltilmiş hacim ölçeği)\n")
cat("============================================================\n")

print(lojistik_sonuc)


# ----------------------------------------------------------------------
# 22. ROC ANALİZİ
# ----------------------------------------------------------------------
#
# ROC analizi KEŞİFSEL analizdir.
#
# Buradan çıkan cut-off:
#
# "optimal cerrahi LEEP hacmi"
#
# olarak yorumlanmayacaktır.
#
# Yalnızca mevcut veri setinde rezidü pozitifliği ayıran
# keşifsel eşik değeri olarak raporlanacaktır.
#
# NOT: AUC, sensitivite ve spesifisite formül düzeltmesinden
# ETKİLENMEZ (monotonik dönüşüme duyarsız). Ama Youden eşik
# değeri (cm³) artık doğru ölçekte - eski (yanlış) formülle
# hesaplanan eşiğin YARISI değil, gerçek ölçekte raporlanıyor.
# ----------------------------------------------------------------------

roc_hacim <- pROC::roc(

  response =
    hacim_analiz$rezidu_binary,

  predictor =
    hacim_analiz$leep_hacim_cm3,

  levels = c(0, 1),

  direction = "auto",

  ci = TRUE,

  quiet = TRUE
)


auc <- as.numeric(
  pROC::auc(roc_hacim)
)


auc_ci <- as.numeric(
  pROC::ci.auc(roc_hacim)
)


youden <- pROC::coords(

  roc_hacim,

  x = "best",

  best.method = "youden",

  ret = c(
    "threshold",
    "sensitivity",
    "specificity"
  ),

  transpose = FALSE
)


roc_sonuc <- data.frame(

  AUC =
    auc,

  AUC_Alt_95_GA =
    auc_ci[1],

  AUC_Ust_95_GA =
    auc_ci[3],

  Youden_Esik_cm3 =
    as.numeric(
      youden$threshold
    ),

  Sensitivite =
    as.numeric(
      youden$sensitivity
    ),

  Spesifisite =
    as.numeric(
      youden$specificity
    )
)


cat("\n")
cat("============================================================\n")
cat("ROC ANALİZİ (düzeltilmiş hacim ölçeği)\n")
cat("============================================================\n")

print(roc_sonuc)


