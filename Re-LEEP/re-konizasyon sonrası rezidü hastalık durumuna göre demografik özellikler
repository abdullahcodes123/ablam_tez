# 28. GÜVENLİ SHAPIRO FONKSİYONU
# =====================================================================

guvenli_shapiro <- function(x) {
    
    x <- x[
        !is.na(x)
    ]
    
    
    if (
        length(x) < 3 ||
        length(x) > 5000
    ) {
        
        return(
            NA_real_
        )
        
    }
    
    
    if (
        length(unique(x)) < 2
    ) {
        
        return(
            NA_real_
        )
        
    }
    
    
    sonuc <- tryCatch(
        
        shapiro.test(x),
        
        error = function(e) NULL
        
    )
    
    
    if (is.null(sonuc)) {
        
        return(
            NA_real_
        )
        
    }
    
    
    sonuc$p.value
    
}



