  while (
    power_kategorik(n_karsi = ust, n_sabit = n_sabit, h = h, alfa = alfa) < hedef_power &&
    ust < max_n
  ) {
    ust <- min(ust * 2L, max_n)
  }
  
  while (alt < ust) {
    orta <- floor((alt + ust) / 2)
    pw <- power_kategorik(n_karsi = orta, n_sabit = n_sabit, h = h, alfa = alfa)
    if (pw >= hedef_power) {
