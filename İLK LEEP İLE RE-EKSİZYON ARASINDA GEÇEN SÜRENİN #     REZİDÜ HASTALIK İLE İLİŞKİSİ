# =====================================================================
# 14. İKİ İŞLEM ARASINDAKİ AY FARKINI HESAPLA
# =====================================================================
#
# FORMÜL:
#
# (Re-eksizyon yılı - İlk LEEP yılı) × 12
#
# +
#
# (Re-eksizyon ayı - İlk LEEP ayı)
#
#
# ÖRNEK:
#
# Mayıs 2025 -> Eylül 2025
#
# (2025 - 2025) × 12 + (9 - 5)
#
# = 4 ay
#
# =====================================================================

analiz <- analiz %>%

  mutate(

    sure_ay =

      (
        reeksizyon_yil -
          ilk_leep_yil
      ) * 12 +

      (
        reeksizyon_ay -
          ilk_leep_ay
      )

  )



