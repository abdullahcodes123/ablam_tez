# 34. ANA GRUP KARŞILAŞTIRMASI
#
# MANN-WHITNEY U TESTİ
# =====================================================================
#
# Önceki analizde her iki grupta da Shapiro-Wilk testi
# anlamlı bulunmuştu.
#
# Ayrıca süre değişkeni ay cinsinden ayrık ve sağa çarpık
# bir dağılım gösterebilir.
#
# Bu nedenle ana grup karşılaştırmasında Mann-Whitney U
# kullanıyoruz.
#
# ties bulunması beklenir; çünkü süre artık tam ay olarak
# hesaplanmaktadır.
#
# Bu nedenle exact = FALSE kullanıyoruz.
# =====================================================================

mann_whitney_sonuc <- wilcox.test(

  sure_ay ~ rezidu_grup,

  data = sure_analiz,

  exact = FALSE

)


